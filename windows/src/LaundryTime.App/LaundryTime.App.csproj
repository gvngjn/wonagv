<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 위치 API(Windows.Devices.Geolocation) 사용: Windows 10 2004 이상 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)용 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Linux/macOS에서도 빌드할 수 있도록 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LaundryTime</AssemblyName>
    <RootNamespace>LaundryTime.App</RootNamespace>
    <Product>빨래 타이밍</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF와 WinForms 타입 이름 충돌 방지 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaundryTime.Core\LaundryTime.Core.csproj" />
  </ItemGroup>

</Project>
