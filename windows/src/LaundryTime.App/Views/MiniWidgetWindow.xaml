<Window x:Class="LaundryTime.App.Views.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaundryTime.App.Views"
        Title="빨래 타이밍 위젯" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <!-- 모서리의 작은 −/+ 버튼 -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 그림자가 잘리지 않도록 여백 -->
    <Grid Margin="8">
        <Border CornerRadius="16" Background="#F2FFFFFF" BorderBrush="#22000000" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="열기" Click="OnOpen" />
                    <MenuItem Header="최소화 모드" IsCheckable="True" IsChecked="{Binding MiniWidgetCompact}" />
                    <MenuItem Header="새로고침" Command="{Binding RefreshCommand}" />
                    <Separator />
                    <MenuItem Header="위젯 숨기기" Click="OnHide" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- 기본 모드 -->
                <StackPanel Width="254" Margin="16,12,16,14"
                            Visibility="{Binding MiniWidgetCompact, Converter={x:Static local:InverseBoolToVisibility.Instance}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ModeButton}" Content="−" FontSize="14"
                                ToolTip="최소화" Click="OnToggleCompact" Margin="6,0,-8,0" VerticalAlignment="Top" />
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding LevelBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HumidityText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding LocationName}" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 최소화 모드: 한 줄 알약 -->
                <StackPanel Orientation="Horizontal" Margin="12,6,6,6"
                            ToolTip="{Binding Headline}"
                            Visibility="{Binding MiniWidgetCompact, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="10" Height="10" Fill="{Binding LevelBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HumidityText}" FontSize="15" FontWeight="Bold" Margin="6,0,0,0"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="·" Margin="6,0" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ShortHeadline}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ModeButton}" Content="+" FontSize="14" Margin="4,0,0,0"
                            ToolTip="크게 보기" Click="OnToggleCompact" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
