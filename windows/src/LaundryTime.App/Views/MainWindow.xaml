<Window x:Class="LaundryTime.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaundryTime.App.Views"
        Title="빨래 타이밍" Width="480" Height="820" MinWidth="400" MinHeight="500"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource AppFont}" Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <!-- 요약 카드 -->
            <Border Style="{StaticResource Card}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="#EAF4FD" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{Binding LevelBrush}" CornerRadius="10" Padding="10,3">
                            <TextBlock Text="{Binding LevelTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center">
                            <Run Text="📍" /> <Run Text="{Binding LocationName, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,12,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="습도" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding HumidityText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="기온" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TemperatureText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="바람" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding WindText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <TextBlock Text="강수확률" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RainText}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshCommand}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="UpdatedText" />
                                    <Binding Path="IsLoading" Converter="{x:Static local:LoadingSuffix.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D64545" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={x:Static local:NotEmptyToVisibility.Instance}}" />
                </StackPanel>
            </Border>

            <!-- 추천 시간대 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="추천 시간대" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="앞으로 3일간 널기 좋은 시간이 없어요. 실내 건조를 추천해요."
                               Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"
                               Visibility="{Binding HasNoWindows, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <Border DockPanel.Dock="Right" Background="{Binding LevelBrush}" CornerRadius="10"
                                            Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LevelTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TimeRange}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 시간별 차트 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="시간별 건조 점수 (48시간)" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnChartMouseWheel">
                        <ItemsControl ItemsSource="{Binding HourBars}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="14" Margin="1,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                        <Grid Height="120">
                                            <Border Height="{Binding BarHeight}" Background="{Binding Brush}"
                                                    CornerRadius="3,3,0,0" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource SubtleBrush}"
                                                   HorizontalAlignment="Left" Margin="0,3,-20,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="막대에 마우스를 올리면 시간별 습도를 볼 수 있어요. 연한 파랑은 비 예보예요." />
                </StackPanel>
            </Border>

            <!-- 설정 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="설정" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="지역" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="검색" Command="{Binding SearchCommand}" Margin="6,0,0,0"
                                IsDefault="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,5" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding SearchMessage}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding SearchMessage, Converter={x:Static local:NotEmptyToVisibility.Instance}}" />
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPlace}"
                             DisplayMemberPath="Name" MaxHeight="160" Margin="0,4,0,0" BorderThickness="0"
                             Visibility="{Binding SearchResults.Count, Converter={x:Static local:NotEmptyToVisibility.Instance}}" />

                    <TextBlock Text="계산 방식" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                    <ComboBox ItemsSource="{Binding ScoringModes}" SelectedItem="{Binding SelectedScoringMode}"
                              DisplayMemberPath="Title" Padding="6,5" />

                    <CheckBox Content="추천 시간 30분 전에 알림" IsChecked="{Binding NotificationsEnabled}" Margin="0,14,0,0" />
                    <CheckBox Content="바탕화면 미니 위젯 표시" IsChecked="{Binding MiniWidgetVisible}" Margin="0,8,0,0" />
                    <CheckBox Content="Windows 시작 시 자동 실행" IsChecked="{Binding RunAtStartup}" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="기본은 습도만으로 판단해요 (습도 40% 이하 100점, 85% 이상 0점). 비 오는 시간은 항상 제외돼요. 창을 닫아도 트레이에서 계속 알려드려요." />
                </StackPanel>
            </Border>

            <TextBlock Text="날씨 데이터: Open-Meteo.com" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Window>
